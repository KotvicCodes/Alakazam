{
    "name": "alakazam",
    "version": "1.3.2",
    "description": "Analyzes and optimizes Cookie Clicker strategy",
    "scripts": {
        "test": "node scripts/test-unit.cjs",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test:browser": "playwright test --project=game",
        "test:extension": "playwright test --project=extension",
        "test:integration": "playwright test",
        "test:game:fetch": "node scripts/fetch-test-game.cjs"
    },
    "devDependencies": {
        "prettier": "^3.1.0",
        "@playwright/test": "1.64.1"
    },
    "prettier": {
        "semi": false,
        "singleQuote": true,
        "tabWidth": 4,
        "printWidth": 105,
        "trailingComma": "none",
        "arrowParens": "avoid"
    },
    "engines": {
        "node": "^22.22.0 || ^24.0.0"
    }
}
